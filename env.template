# 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==================== 数据库配置 ====================
# 本地开发
DATABASE_URL=postgresql://localhost:5432/food_tracking_db

# Heroku/Render 会自动提供此变量，无需手动设置
# DATABASE_URL=postgresql://username:password@host:5432/database

# ==================== API Keys ====================
# Gemini API (Google AI Studio)
# 获取: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ConvAI API (ConvAI.com)
# 获取: https://convai.com/
CONVAI_API_KEY=your_convai_api_key_here

# ==================== 应用配置 ====================
# 环境: development, production
NODE_ENV=production

# 端口（Heroku/Render 会自动设置）
PORT=3001

# 会话密钥（随机生成至少32位）
SESSION_SECRET=your_random_secret_key_minimum_32_characters

# ==================== 可选配置 ====================
# API 基础 URL（前端访问后端的地址）
# 本地: http://localhost:3001
# 生产: https://your-app.herokuapp.com
REACT_APP_API_URL=http://localhost:3001

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 启用调试模式
DEBUG=false

# ==================== Heroku 专用 ====================
# Heroku 会自动设置这些变量
# HEROKU_APP_NAME=your-app-name
# DYNO=web.1
# DATABASE_URL=...

# ==================== 注意事项 ====================
# 1. 不要将 .env 文件提交到 Git
# 2. 在 Heroku/Render 中通过 Dashboard 或 CLI 设置环境变量
# 3. SESSION_SECRET 必须是随机字符串，可以用以下命令生成:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. 确保所有 API Keys 都正确设置

